# Copy this file to .env.local and fill it in.

# Google Gemini API key for the AI waiter.
# Get one free at https://aistudio.google.com/apikey
# WITHOUT this key the app still works: it falls back to a built-in
# rule-based recommender so you can demo everything offline.
GEMINI_API_KEY=

# Which Gemini model to use. Default is gemini-2.5-flash (fast + cheap).
# GEMINI_MODEL=gemini-2.5-pro

# Public base URL used when generating QR codes.
# In development leave it empty and the browser origin is used.
# In production set it to the FINAL domain before printing any QR codes.
NEXT_PUBLIC_BASE_URL=

# Secret used to sign the table tokens inside QR codes, so a guest can't edit
# the table number in the URL. Generate with:  openssl rand -base64 32
# Changing it later invalidates every printed QR code.
TABLE_TOKEN_SECRET=

# Set to 1 to keep the plain ?table=N URLs working in production (not advised).
# ALLOW_PLAIN_TABLE=1
